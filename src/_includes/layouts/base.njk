<!doctype html>
<html lang="{{ language or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#fcf9f8">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&amp;family=JetBrains+Mono:wght@400;500&amp;family=Source+Sans+3:wght@400;500;600&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
  {% if math %}<link rel="stylesheet" href="/assets/katex/katex.min.css">{% endif %}
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="content" class="container">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
