<article class="entry archive-entry">
  <div class="meta"><time datetime="{{ entry.date | isoDate }}">{{ entry.date | readableDate }}</time>{% if entry.data.category %}<span>{{ entry.data.category }}</span>{% endif %}</div>
  <h3><a href="{{ entry.url }}">{{ entry.data.title }}</a></h3>
  <p>{{ entry.data.description }}</p>
  <a class="text-link" href="{{ entry.url }}">{{ entryLabel or 'Read the post →' }}</a>
</article>
